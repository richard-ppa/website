{
  "name": "ppa-website",
  "version": "1.0.0",
  "description": "Plane Place Aviation — Hawker, Citation & Challenger MRO",
  "scripts": {
    "dev": "next dev",
    "build": "tsx --env-file-if-exists=.env.local scripts/fetch-articles.ts && next build",
    "deploy": "next build && npx --yes wrangler@latest pages deploy out --project-name=ppa-website --branch=master --commit-dirty=true",
    "start": "next start",
    "lint": "next lint",
    "seed:articles": "tsx --env-file-if-exists=.env.local scripts/seed-articles.ts",
    "seed:challenger": "tsx --env-file-if-exists=.env.local scripts/seed-challenger-draft.ts",
    "seed:challenger-96month": "tsx --env-file-if-exists=.env.local scripts/seed-challenger-96month.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "next": "^16.2.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  }
}
