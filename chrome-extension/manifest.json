{
  "manifest_version": 3,
  "name": "PPA Estimate Cover",
  "version": "1.0.0",
  "description": "Generate and merge cover pages onto customer estimate PDFs",
  "action": {
    "default_title": "PPA Estimate Cover",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": []
}
